# JARVIS ENVIRONMENT TEMPLATE
# Copy this to .env.local and fill in your keys

# Core
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Web Intelligence
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# AI Models
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# Communication
WHATSAPP_PHONE_NUMBER=9606571200
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Services
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Intelligence Vault (Database)
DATABASE_URL="file:./dev.db"

# System-wide clipboard assistant (npm run clipboard, from the jarvis/ folder)
# Copy anything anywhere on the laptop: JARVIS detects what it is and shows that
# kind's buttons next to the cursor (no model call until you click one).
# Values below are the defaults - keep comments on their own lines.
CLIPBOARD_ASSIST=on
# detected-kind action buttons (off = a single "Ask JARVIS" button)
CLIPBOARD_ACTIONS=on
# ask before spending a model call
CLIPBOARD_ASK_FIRST=on
# offer Analyze / Extract text for copied images
CLIPBOARD_IMAGES=on
# let "Apply on screen" paste the fix over the code you copied
CLIPBOARD_APPLY_ON_SCREEN=on
# card next to the cursor: on|off
CLIPBOARD_POPUP=on
# pointer | topright | bottomright | topleft | bottomleft
CLIPBOARD_POPUP_POS=pointer
CLIPBOARD_POPUP_WIDTH=320
CLIPBOARD_POPUP_TIMEOUT_MS=30000
CLIPBOARD_POPUP_OFFSET=18
CLIPBOARD_MIN_CHARS=3
CLIPBOARD_MAX_CHARS=8000
CLIPBOARD_POLL_MS=700

# Browser agent — a visible, watchable window is the default. Set to 0 for headless.
JARVIS_BROWSER_VISIBLE=1
# How long to wait for you to finish a sign-in before giving up (ms).
JARVIS_LOGIN_WAIT_MS=240000

# Autofill profile — the browser agent fills these into any checkout/order form.
JARVIS_PROFILE_NAME=
JARVIS_PROFILE_PHONE=
JARVIS_PROFILE_EMAIL=
JARVIS_PROFILE_ADDRESS=
JARVIS_PROFILE_CITY=
JARVIS_PROFILE_STATE=
JARVIS_PROFILE_PINCODE=
