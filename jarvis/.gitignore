# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — .env holds real API keys, never commit it
.env
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

/.certificates/

# JARVIS runtime data (durable missions, recordings, artifacts)
/.jarvis-data/
/.browser-sessions/

# messaging session dumps — these contain live login cookies
/.whatsapp-session*/
/.whatsapp-session-*/
/.wwebjs_auth/
/.wwebjs_cache/
*.session-jarvis-*/

# local database + personal runtime state
/dev.db
/dev.db-wal
/dev.db-shm
/.jarvis-memory.json
/.jarvis_macros.json

# MCP server config can carry access tokens
/.mcp.json

# throwaway scripts — they have a habit of hardcoding live API keys
/scratch/

# dev server logs (noisy, and logs leak tokens)
/dev-out.log
/dev-err.log

# live sqlite database — holds memories, emails and queued messages
/prisma/dev.db
/prisma/dev.db-wal
/prisma/dev.db-shm

# screen captures of the desktop / filled-in forms
/public/automation/
/zoom_webinar_reg*.png
