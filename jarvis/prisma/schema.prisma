generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User memories - facts about the user
model Memory {
  id             String    @id @default(cuid())
  content        String
  category       String    // user_fact, preference, context, conversation
  source         String    // conversation_id or "explicit"
  strength       Float     @default(1.0)
  lastAccessed   DateTime?
  pinned         Boolean   @default(false)
  linkedEntityId String?   // back-reference to graph entity when this Memory was spawned from one
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([category])
  @@index([pinned])
  @@index([linkedEntityId])
}

// Conversations with JARVIS
model Conversation {
  id        String    @id @default(cuid())
  messages  Message[]
  summary   String?   // AI-generated summary
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  role           String       // user, assistant
  content        String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

// Tasks and reminders
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  priority    String    // critical, high, normal, someday
  category    String?   // work, personal, health, etc.
  dueDate     DateTime?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Notes with auto-tags
model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  tags      String?  // comma-separated tags
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tags])
}

// Skill learning plans
model SkillPlan {
  id          String   @id @default(cuid())
  userId      String   @default("default")
  topic       String
  difficulty  String
  duration    Int      // number of days
  plan        String   // JSON string of the learning plan
  progress    Int      @default(0) // percentage complete
  currentDay  Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// Quiz results
model QuizResult {
  id        String   @id @default(cuid())
  userId    String   @default("default")
  planId    String?
  topic     String
  score     Int      // percentage
  answers   String   // JSON of answers
  createdAt DateTime @default(now())
}

// Knowledge Graph - Entities (people, companies, projects, concepts)
model Entity {
  id           String    @id @default(cuid())
  name         String
  type         String    // PERSON, COMPANY, PROJECT, CONCEPT, LOCATION, SKILL, PREFERENCE, EVENT
  description  String?
  metadata     String?   // JSON string for encrypted data
  strength     Float     @default(1.0)  // current decay-adjusted score (cached)
  baseStrength Float     @default(1.0)  // untouched score for re-computation
  lastAccessed DateTime?
  accessCount  Int       @default(0)
  cue          String?   // retrieval-trigger question phrased by user
  pinned       Boolean   @default(false)
  archived     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  relations  Relationship[] @relation("sourceEntity")
  relatedTo  Relationship[] @relation("targetEntity")

  @@index([type])
  @@index([name])
  @@index([archived])
  @@index([pinned])
}

// Memory events - raw signal stream for pattern-of-life observability
model MemoryEvent {
  id        String   @id @default(cuid())
  kind      String   // search | panel | contact | chat | goal | briefing
  payload   String   // JSON
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

// Knowledge Graph - Relationships between entities
model Relationship {
  id         String   @id @default(cuid())
  sourceId   String
  source     Entity   @relation("sourceEntity", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId   String
  target     Entity   @relation("targetEntity", fields: [targetId], references: [id], onDelete: Cascade)
  type       String   // works_at, client_of, knows_about, prefers, friend_of, etc.
  strength   Float    @default(1.0)  // confidence/relevance score
  metadata   String?  // JSON string for encrypted data
  createdAt  DateTime @default(now())

  @@index([sourceId])
  @@index([targetId])
  @@index([type])
}

// Tier 2B: Scheduled goals — recurring agent jobs.
model ScheduledJob {
  id        String    @id @default(cuid())
  name      String
  cron      String    // 5-field cron expression
  goal      String    // raw goal string fed to AgentService.planGoal
  enabled   Boolean   @default(true)
  lastRun   DateTime?
  lastJobId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([enabled])
}

// Oracle Research — completed report library.
// Persists every finished research task so the panel can show history,
// and so contextual follow-up research can reuse prior facts.
model Report {
  id              String    @id @default(cuid())
  query           String
  reportType      String    // comparison | deep_research | news_roundup | briefing_memo | how_to | market_scan
  status          String    // planning | searching | scraping | synthesizing | completed | failed
  progress        Int       @default(0)
  // JSON-encoded structured blocks (Notion block schema). Always present
  // on completion; null for in-flight or failed reports.
  structuredBlocks String?
  // Plain markdown fallback for the panel preview and for "Copy to clipboard".
  reportMarkdown  String?
  notionUrl       String?
  // For comparison reports: list of subjects researched in parallel.
  subjects        String?   // JSON-encoded string[] (e.g. ["iPhone 17 Pro Max", "Galaxy Z Fold 7"])
  // Aggregated metrics.
  factsCount      Int       @default(0)
  sourcesCount    Int       @default(0)
  // For follow-up: id of the parent report this one was derived from.
  parentReportId  String?
  parentReport    Report?   @relation("ReportFollowups", fields: [parentReportId], references: [id])
  followups       Report[]  @relation("ReportFollowups")
  // The active in-memory task id at time of completion. Useful for backref
  // from ResearchService.activeTasks if the process didn't restart.
  taskId          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  @@index([reportType])
  @@index([status])
  @@index([createdAt])
  @@index([parentReportId])
}

// Telegram remote-control queue.
// Authoritative store for both inbound and outbound Telegram messages so
// the laptop can pick up messages sent while the dev server was asleep,
// and so the React panel can read history without a parallel in-memory
// buffer. `chatId` is BigInt because Telegram chat IDs exceed Int32.
model TelegramMessage {
  id            String   @id @default(cuid())
  chatId        BigInt
  telegramMsgId BigInt?  // the message_id Telegram gave us, if any
  direction     String   // "inbound" | "outbound"
  text          String
  status        String   // "pending" | "processing" | "sent" | "failed" | "rejected"
  replyToId     String?  // cuid of the inbound row this outbound replies to
  metadata      String?  // JSON: { buttons?, audioUrl?, attachments?, parseMode? }
  error         String?  // last error message if status = "failed"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([chatId, status])
  @@index([status, createdAt])
  @@index([direction, createdAt])
}

// Telegram reminders — user-scheduled pings ("remind me in 5 min to
// stretch"). Picked up by a 30s cron loop and delivered to the same
// chat. `fireAt` is UTC; quiet-hours window is per-reminder and is
// compared against Asia/Kolkata in the dispatcher. `idempotencyKey`
// dedupes rapid double-taps of the same command.
model Reminder {
  id               String    @id @default(cuid())
  chatId           BigInt
  fireAt           DateTime
  text             String
  createdFromMsgId BigInt?
  status           String    @default("pending") // pending | processing | dispatched | cancelled | failed
  dispatchedAt     DateTime?
  error            String?
  idempotencyKey   String?
  // Quiet hours stored as minutes-of-day; default IST 23:00 → 07:00.
  quietStartMin    Int       @default(1380)
  quietEndMin      Int       @default(420)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, fireAt])
  @@index([chatId, fireAt])
  @@unique([chatId, idempotencyKey])
}

// Telegram user location — one row per chat, latest write wins.
// Populated when the user shares a location via the Telegram
// attachment menu. Exposed via /whereami and /api/telegram/location.
model UserLocation {
  chatId           BigInt   @id
  latitude         Float
  longitude        Float
  accuracyM        Float?
  livePeriodSeconds Int?
  heading          Float?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

// Telegram destructive-OS actions — written when a chat requests
// shutdown / restart so the user can confirm via inline button.
// TTL of 5 minutes; the callback handler refuses expired rows.
model PendingOsAction {
  id        String   @id @default(cuid())
  chatId    BigInt
  action    String   // "shutdown" | "restart"
  params    String?  // JSON: { delaySec?: number }
  status    String   @default("pending") // pending | confirmed | cancelled | expired
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId, status])
  @@index([expiresAt])
}

// Composio connected-app registry. One row per (userId, toolkitSlug).
// We re-fetch from composio on every /api/composio/connections call,
// but cache the authConfigId + connectedAccountId here so the listener
// can resume triggers without re-doing OAuth.
model ComposioConnection {
  id                  String   @id @default(cuid())
  userId              String   // COMPOSIO_USER_ID (defaults to "jarvis-local")
  toolkitSlug         String   // "gmail" | "gcal" | "github" | ...
  connectedAccountId  String   // composio's nano id for the linked account
  authConfigId        String   // composio's auth config id
  status              String   // "ACTIVE" | "INACTIVE" | "INITIATED"
  connectedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, toolkitSlug])
  @@index([status])
}

// Composio event dedupe + delivery log.
// `seenKey` is the composio trigger id (or "<source>:<id>" for synthetic
// events). It is the dedupe key — if a row exists, the listener drops
// the duplicate. Rows older than `retentionUntil` are GC'd by a daily
// sweep (TODO: phase 2).
model ComposioEventLog {
  id            String   @id @default(cuid())
  seenKey       String   @unique
  source        String   // JarvisEvent.source
  type          String   // JarvisEvent.type
  title         String
  body          String
  url           String?
  priority      String   // "low" | "normal" | "high"
  rawPayload    String?  // JSON
  telegramSent  Boolean  @default(false)
  desktopPushed Boolean  @default(false)
  error         String?
  receivedAt    DateTime @default(now())
  retentionUntil DateTime

  @@index([source, receivedAt])
  @@index([retentionUntil])
}

// Per-day event counter for the composio free-tier ceiling (20k/mo).
// One row per UTC day. `count` increments on every real event delivered;
// the panel shows today/total.
model ComposioUsage {
  day       String   @id // "YYYY-MM-DD" (UTC)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}
